# Use a generated random value of at least 32 characters for production.
DEPLOY_ENV=production
SUPPLYCHAIN_API_KEY=
DATABASE_PATH=/app/var/application.sqlite
PORT=8000

# Separate random secret for signed ERPNext order webhooks.
ERPNEXT_WEBHOOK_SECRET=

AUTOPILOT_ENABLED=true
# SMTP secrets remain server-side. Synthetic demo alerts never email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
